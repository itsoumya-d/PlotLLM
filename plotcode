#!/usr/bin/env python3
"""
PlotCode - AI-powered plot generation using your GLM 4.5 subscription
"""

import sys
import argparse
import json
from glm_chat import assistant_response, check_service

def main():
    parser = argparse.ArgumentParser(description='Generate plots using AI and your GLM subscription')
    parser.add_argument('prompt', nargs='*', help='Description of the plot to generate')
    parser.add_argument('--model', '-m', default='glm-4.5', 
                       choices=['glm-4.5', 'glm-4.5-air', 'glm-4.5-flash', 'glm-4.5v'],
                       help='GLM model to use')
    parser.add_argument('--output', '-o', help='Save code to file instead of executing')
    parser.add_argument('--execute', '-e', action='store_true', help='Execute the generated code')
    parser.add_argument('--interactive', '-i', action='store_true', help='Start interactive mode')
    
    args = parser.parse_args()
    
    # Check if GLM credentials are available
    if not check_service():
        print("❌ Error: GLM API credentials not found.")
        print("   Make sure your OpenCode GLM setup is configured correctly.")
        print("   Run 'opencode auth list' to check your credentials.")
        return 1
    
    print(f"🚀 PlotCode - AI Plot Generator")
    print(f"   Using GLM model: {args.model}")
    print(f"   Connected to ZAI GLM 4.5 subscription ✅")
    print()
    
    if args.interactive:
        interactive_mode(args.model)
    elif args.prompt:
        prompt = ' '.join(args.prompt)
        generate_plot(prompt, args.model, args.output, args.execute)
    else:
        # Read from stdin if no prompt provided
        try:
            prompt = input("📊 Describe the plot you want to create: ")
            generate_plot(prompt, args.model, args.output, args.execute)
        except KeyboardInterrupt:
            print("\n👋 Goodbye!")
            return 0

def interactive_mode(model):
    print("🎯 Interactive Mode - Type 'exit' or 'quit' to end")
    print("=" * 50)
    
    history = []
    
    while True:
        try:
            prompt = input("\n📊 PlotCode> ")
            
            if prompt.lower() in ['exit', 'quit', 'q']:
                print("👋 Goodbye!")
                break
                
            if not prompt.strip():
                continue
                
            generate_plot_interactive(prompt, model, history)
            
        except KeyboardInterrupt:
            print("\n👋 Goodbye!")
            break

def generate_plot_interactive(prompt, model, history):
    print(f"\n🤖 Generating plot with {model}...")
    
    response_text, response_code = assistant_response(prompt, history, model)
    
    # Add to history
    history.append({"role": "user", "content": prompt})
    history.append({"role": "assistant", "content": response_text})
    
    print(f"\n💬 Response:")
    print(response_text)
    
    if response_code:
        print(f"\n📝 Generated Code:")
        print("```python")
        print(response_code)
        print("```")
        
        # Ask if user wants to execute the code
        try:
            execute = input("\n❓ Execute this code? (y/n): ").lower().startswith('y')
            if execute:
                execute_code(response_code)
        except KeyboardInterrupt:
            pass

def generate_plot(prompt, model, output_file=None, execute=False):
    print(f"🤖 Generating plot: {prompt}")
    print(f"   Using model: {model}")
    
    response_text, response_code = assistant_response(prompt, [], model)
    
    print(f"\n💬 Response:")
    print(response_text)
    
    if response_code:
        print(f"\n📝 Generated Code:")
        print("```python")
        print(response_code)
        print("```")
        
        if output_file:
            with open(output_file, 'w') as f:
                f.write(response_code)
            print(f"\n💾 Code saved to: {output_file}")
        
        if execute:
            execute_code(response_code)
    else:
        print("\n❌ No code was generated. Try rephrasing your request.")

def execute_code(code):
    print(f"\n⚡ Executing code...")
    try:
        import matplotlib.pyplot as plt
        import numpy as np
        import pandas as pd
        
        # Create execution environment
        exec_globals = {
            'plt': plt,
            'np': np,
            'pd': pd,
            'matplotlib': plt.matplotlib,
            'numpy': np,
            'pandas': pd
        }
        
        exec(code, exec_globals)
        print("✅ Code executed successfully!")
        
    except Exception as e:
        print(f"❌ Error executing code: {e}")

if __name__ == "__main__":
    sys.exit(main())